@model IReadOnlyList<AIPlacement.Application.Jobs.DTOs.JobDriveDto>
@{ ViewData["Title"] = "Job Drives"; }
<div class="page-heading"><div><h1>Explore Job Drives</h1><p>Find approved opportunities that are open for applications.</p></div></div>
<form method="get" class="card card-body mb-4"><div class="input-group"><input name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Search title or location"/><button class="btn btn-primary">Search</button></div></form>
<div class="row g-4">
@foreach (var job in Model) {
 <div class="col-md-6 col-xl-4"><div class="card h-100"><div class="card-body"><span class="badge text-bg-success mb-2">@job.Status</span><h4>@job.JobTitle</h4><p class="text-muted">@job.Location · @job.SalaryPackage.ToString("N2") LPA</p><p>Minimum CGPA: @job.MinCGPA · Deadline: @job.ApplicationDeadline.ToString("dd MMM yyyy")</p><a asp-action="Details" asp-route-id="@job.JobDriveId" class="btn btn-outline-primary">View details</a></div></div></div>
}
</div>
@if (!Model.Any()) { <div class="alert alert-info">No open job drives match your search.</div> }
