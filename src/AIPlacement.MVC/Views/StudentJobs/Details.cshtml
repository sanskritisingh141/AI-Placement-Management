@model AIPlacement.Application.Jobs.DTOs.JobDriveDto
@using AIPlacement.Application.Recruitment.DTOs
@using AIPlacement.Application.AI.DTOs
@{
    var eligibility = (EligibilityResultDto)ViewBag.Eligibility;
    var match = ViewBag.Match as JobMatchResultDto;
    ViewData["Title"] = Model.JobTitle;
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="job-details-grid">
    <section class="content-card job-overview-card">
        <span class="page-kicker">Job opportunity</span>
        <h1>@Model.JobTitle</h1>
        <p class="job-subtitle">@Model.Location <span>•</span> @Model.SalaryPackage.ToString("N2") LPA</p>
        <p class="job-description">@Model.JobDescription</p>

        <div class="job-facts">
            <div><small>Minimum CGPA</small><strong>@Model.MinCGPA</strong></div>
            <div><small>Maximum backlogs</small><strong>@Model.MaxBacklogs</strong></div>
            <div><small>Graduation year</small><strong>@Model.GraduationYear</strong></div>
        </div>

        <div class="eligibility-box @(eligibility.IsEligible ? "is-eligible" : "is-ineligible")">
            <span aria-hidden="true">@(eligibility.IsEligible ? "✓" : "!")</span>
            <div>
                <strong>@(eligibility.IsEligible ? "You are eligible for this drive" : "Eligibility requirements not met")</strong>
                @if (!eligibility.IsEligible)
                {
                    <p>@string.Join(" ", eligibility.Reasons)</p>
                }
            </div>
        </div>

        <div class="job-actions">
            <form asp-action="CalculateMatch" asp-route-id="@Model.JobDriveId" method="post">
                <button class="btn btn-outline-primary" type="submit">Calculate AI match</button>
            </form>
            @if (eligibility.IsEligible)
            {
                <form asp-action="Apply" asp-route-id="@Model.JobDriveId" method="post">
                    <button class="btn btn-primary" type="submit">Apply now</button>
                </form>
            }
        </div>
    </section>

    <aside class="content-card match-result-card">
        @if (match is not null)
        {
            var score = Math.Clamp(match.MatchScore, 0, 100);
            <div class="match-score-heading"><div><span class="page-kicker">Resume insight</span><h2>Your AI match</h2></div><strong>@score.ToString("0")%</strong></div>
            <div class="progress match-progress" role="progressbar" aria-label="AI match score" aria-valuenow="@score" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: @score%"></div>
            </div>

            <div class="match-section">
                <span class="analysis-label">Missing required skills</span>
                @if (match.MissingSkills.Any())
                {
                    <div class="gap-skills">
                        @foreach (var skill in match.MissingSkills)
                        {
                            <span>@skill</span>
                        }
                    </div>
                }
                else
                {
                    <p class="match-positive">✓ No required skill gaps found.</p>
                }
            </div>

            <div class="match-recommendation">
                <span aria-hidden="true">✦</span>
                <div><strong>Recommendation</strong><p>@match.Recommendation</p></div>
            </div>
        }
        else
        {
            <div class="match-empty">
                <span aria-hidden="true">✦</span>
                <h2>See how well you match</h2>
                <p>Analyze your current resume, then calculate a match to review your score and missing required skills.</p>
            </div>
        }
    </aside>
</div>
