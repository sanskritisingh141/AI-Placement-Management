@model AIPlacement.Application.Jobs.DTOs.JobDriveDto
@using AIPlacement.Application.Recruitment.DTOs
@using AIPlacement.Application.AI.DTOs
@{ var eligibility=(EligibilityResultDto)ViewBag.Eligibility; var match=ViewBag.Match as JobMatchResultDto; ViewData["Title"]=Model.JobTitle; }
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="card"><div class="card-body p-4"><h1>@Model.JobTitle</h1><p class="text-muted">@Model.Location · @Model.SalaryPackage.ToString("N2") LPA</p><p>@Model.JobDescription</p>
<div class="row g-3"><div class="col-md-4"><strong>Minimum CGPA</strong><div>@Model.MinCGPA</div></div><div class="col-md-4"><strong>Max backlogs</strong><div>@Model.MaxBacklogs</div></div><div class="col-md-4"><strong>Graduation year</strong><div>@Model.GraduationYear</div></div></div><hr/>
<h5>Eligibility</h5><div class="alert @(eligibility.IsEligible ? "alert-success" : "alert-warning")">@(eligibility.IsEligible ? "You are eligible." : string.Join(" ", eligibility.Reasons))</div>
@if (match is not null) { <h5>AI match: @match.MatchScore.ToString("0.0")%</h5><p>Skill gaps: @(match.MissingSkills.Any()?string.Join(", ",match.MissingSkills):"None")</p><p>@match.Recommendation</p> }
<div class="d-flex gap-2"><form asp-action="CalculateMatch" asp-route-id="@Model.JobDriveId" method="post"><button class="btn btn-outline-primary">Calculate match</button></form>@if(eligibility.IsEligible){<form asp-action="Apply" asp-route-id="@Model.JobDriveId" method="post"><button class="btn btn-primary">Apply now</button></form>}</div>
</div></div>
