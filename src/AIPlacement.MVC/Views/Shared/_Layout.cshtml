@using AIPlacement.Application.Authentication
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI Placement System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <aside class="app-sidebar" id="app-sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index"><span>◆</span> AI Placement System</a>
            <nav class="sidebar-nav">
                @if (User.IsInRole(RoleNames.Student))
                {
                    <span class="nav-label">Overview</span>
                    <a asp-controller="StudentDashboard" asp-action="Index">⌂ <span>Dashboard</span></a>
                    <span class="nav-label">My Profile</span>
                    <a asp-controller="StudentProfile" asp-action="Edit">○ <span>Profile</span></a>
                    <a asp-controller="StudentSkills" asp-action="Index">⌨ <span>Skills</span></a>
                    <a asp-controller="StudentProjects" asp-action="Index">□ <span>Projects</span></a>
                    <a asp-controller="StudentCertifications" asp-action="Index">◎ <span>Certifications</span></a>
                    <a asp-controller="StudentResumes" asp-action="Index">▤ <span>Resume</span></a>
                    <span class="nav-label">Placement</span>
                    <a asp-controller="StudentJobs" asp-action="Index">▣ <span>Job Drives</span></a>
                    <a asp-controller="StudentApplications" asp-action="Index">▤ <span>Applications</span></a>
                }
                else if (User.IsInRole(RoleNames.Company))
                {
                    <span class="nav-label">Recruiter</span>
                    <a asp-controller="CompanyDashboard" asp-action="Index">⌂ <span>Dashboard</span></a>
                    <a asp-controller="CompanyProfile" asp-action="Details">○ <span>Company Profile</span></a>
                    <a asp-controller="JobDrives" asp-action="Index">▣ <span>Job Drives</span></a>
                    <a asp-controller="CompanyRecruitment" asp-action="Index">▤ <span>Applicants</span></a>
                }
                else if (User.IsInRole(RoleNames.Admin))
                {
                    <span class="nav-label">Administration</span>
                    <a asp-controller="Admin" asp-action="Dashboard">⌂ <span>Dashboard</span></a>
                    <a asp-controller="Admin" asp-action="Users">○ <span>Users</span></a>
                    <a asp-controller="Admin" asp-action="JobDriveApprovals">▣ <span>Job Approvals</span></a>
                    <a asp-controller="Admin" asp-action="Applications">▤ <span>Applications</span></a>
                    <a asp-controller="Admin" asp-action="ExportReport">↧ <span>Reports</span></a>
                }
            </nav>
            <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar-logout">
                <button type="submit">↪ <span>Logout</span></button>
            </form>
        </aside>

        <div class="app-main">
            <header class="topbar">
                <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-label="Toggle navigation">☰</button>
                @if (User.IsInRole(RoleNames.Student))
                {
                    <form class="top-search" asp-controller="StudentJobs" asp-action="Index" method="get"><span>⌕</span><input name="search" type="search" placeholder="Search job drives..." aria-label="Search job drives" /></form>
                }
                else if (User.IsInRole(RoleNames.Company))
                {
                    <form class="top-search" asp-controller="JobDrives" asp-action="Index" method="get"><span>⌕</span><input name="search" type="search" placeholder="Search your job drives..." aria-label="Search job drives" /></form>
                }
                else
                {
                    <div class="top-search"><span>⌕</span><span class="text-muted">Placement administration</span></div>
                }
                <div class="user-menu"><span class="avatar-sm">@((User.Identity.Name ?? "U")[..1].ToUpperInvariant())</span><div><strong>@User.Identity.Name</strong><small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small></div></div>
            </header>
            <main class="app-content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <header class="public-header"><a class="brand text-dark" asp-controller="Home" asp-action="Index"><span>◆</span> AI Placement System</a><div><a class="btn btn-link" asp-controller="Account" asp-action="Login">Sign in</a><a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register</a></div></header>
    <main class="container" role="main">@RenderBody()</main>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
