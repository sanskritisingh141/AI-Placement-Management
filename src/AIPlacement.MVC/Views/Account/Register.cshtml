@model AIPlacement.Application.Authentication.DTOs.RegisterRequestDto
@{
    ViewData["Title"] = "Create account";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h3 mb-2">Create your account</h1>
                <p class="text-muted">Register as a student or company recruiter.</p>
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label"></label>
                            <select asp-for="Role" class="form-select" id="role-select">
                                <option value="">Select a role</option>
                                <option value="Student">Student</option>
                                <option value="Company">Company</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>
                    </div>

                    <div id="student-fields" class="row g-3 mt-1">
                        <div class="col-md-6"><label asp-for="RollNo" class="form-label"></label><input asp-for="RollNo" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="Branch" class="form-label"></label><input asp-for="Branch" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="CGPA" class="form-label"></label><input asp-for="CGPA" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="GraduationYear" class="form-label"></label><input asp-for="GraduationYear" class="form-control" /></div>
                    </div>

                    <div id="company-fields" class="mt-3">
                        <label asp-for="CompanyName" class="form-label"></label>
                        <input asp-for="CompanyName" class="form-control" />
                    </div>

                    <button class="btn btn-primary w-100 mt-4" type="submit">Create account</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const role = document.getElementById('role-select');
        const student = document.getElementById('student-fields');
        const company = document.getElementById('company-fields');
        function updateRoleFields() {
            student.hidden = role.value !== 'Student';
            company.hidden = role.value !== 'Company';
        }
        role.addEventListener('change', updateRoleFields);
        updateRoleFields();
    </script>
}
