@model IEnumerable<AIPlacement.Application.Projects.DTOs.ProjectDto>
@{ViewData["Title"]="Projects";}<div class="page-heading"><div><h1>Projects</h1><p>Showcase practical experience.</p></div></div><div class="card mb-4"><div class="card-body"><h4>Add project</h4><form asp-action="Save" method="post" class="row g-2"><div class="col-md-4"><input name="ProjectTitle" class="form-control" placeholder="Title" required/></div><div class="col-md-4"><input name="TechnologiesUsed" class="form-control" placeholder="Technologies"/></div><div class="col-md-4"><input name="ProjectUrl" type="url" class="form-control" placeholder="Project URL"/></div><div class="col-12"><textarea name="Description" class="form-control" placeholder="Description"></textarea></div><div><button class="btn btn-primary">Add project</button></div></form></div></div><div class="row g-3">@foreach(var p in Model){<div class="col-md-6"><div class="card h-100"><div class="card-body"><h4>@p.ProjectTitle</h4><p>@p.Description</p><div class="text-muted">@p.TechnologiesUsed</div>@if(!string.IsNullOrWhiteSpace(p.ProjectUrl)){<a href="@p.ProjectUrl" target="_blank">Open project</a>}<form asp-action="Delete" method="post" class="mt-3"><input type="hidden" name="id" value="@p.ProjectId"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div>}</div>
