@model IReadOnlyList<AIPlacement.Application.Recruitment.DTOs.ApplicantDto>
@{ ViewData["Title"]="My Applications"; }
<div class="page-heading"><div><h1>My Applications</h1><p>Track every application and pipeline update.</p></div></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Company</th><th>Role</th><th>Applied</th><th>Match</th><th>Status</th><th>Remarks</th></tr></thead><tbody>
@foreach(var item in Model){<tr><td>@item.CompanyName</td><td>@item.JobTitle</td><td>@item.AppliedAt.ToString("dd MMM yyyy")</td><td>@(item.MatchScore?.ToString("0.0") ?? "—")</td><td><span class="badge text-bg-primary">@item.CurrentStatus</span></td><td>@item.RecruiterRemarks</td></tr>}
</tbody></table></div></div>
@if(!Model.Any()){<div class="alert alert-info mt-3">You have not applied to any job drives yet.</div>}
