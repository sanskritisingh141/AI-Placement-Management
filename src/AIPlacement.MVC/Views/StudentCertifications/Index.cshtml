@model IEnumerable<AIPlacement.Application.Certifications.DTOs.CertificationDto>
@{ViewData["Title"]="Certifications";}<div class="page-heading"><div><h1>Certifications</h1><p>Manage verified learning credentials.</p></div></div><div class="card mb-4"><div class="card-body"><form asp-action="Save" method="post" class="row g-2"><div class="col-md-4"><input name="CertificateName" class="form-control" placeholder="Certificate" required/></div><div class="col-md-3"><input name="IssuingOrganization" class="form-control" placeholder="Issuer"/></div><div class="col-md-2"><input name="IssueDate" type="date" class="form-control"/></div><div class="col-md-3"><input name="CredentialUrl" type="url" class="form-control" placeholder="Credential URL"/></div><div><button class="btn btn-primary">Add certification</button></div></form></div></div><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Certificate</th><th>Issuer</th><th>Date</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.CertificateName</td><td>@c.IssuingOrganization</td><td>@c.IssueDate?.ToString("dd MMM yyyy")</td><td><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@c.CertificationId"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div></div>
