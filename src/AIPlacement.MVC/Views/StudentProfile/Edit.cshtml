@model AIPlacement.Application.Students.DTOs.StudentDto
@{ ViewData["Title"]="Edit Profile"; }
<div class="card"><div class="card-body p-4"><h1>Edit profile</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="RollNo" class="form-label"></label><input asp-for="RollNo" class="form-control"/></div><div class="col-md-6"><label asp-for="Branch" class="form-label"></label><input asp-for="Branch" class="form-control"/></div><div class="col-md-4"><label asp-for="CGPA" class="form-label"></label><input asp-for="CGPA" class="form-control"/></div><div class="col-md-4"><label asp-for="GraduationYear" class="form-label"></label><input asp-for="GraduationYear" class="form-control"/></div><div class="col-md-4"><label asp-for="CurrentBacklogs" class="form-label"></label><input asp-for="CurrentBacklogs" class="form-control"/></div><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control"/></div><div class="col-md-6"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" type="date" class="form-control"/></div></div><button class="btn btn-primary mt-4">Save changes</button></form></div></div>
