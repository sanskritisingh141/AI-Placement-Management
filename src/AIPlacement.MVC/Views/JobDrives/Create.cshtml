@model AIPlacement.MVC.Models.CompanyAndJob.JobDriveFormViewModel

@{
    var isEdit = Model.JobDriveId.HasValue;
    ViewData["Title"] = isEdit ? "Edit Job Drive" : "Create Job Drive";
}

<div class="mb-4">
    <h1 class="display-6 fw-semibold mb-1">@(isEdit ? "Edit Job Drive" : "Create Job Drive")</h1>
    <p class="text-muted mb-0">
        Enter the job details, required skills and eligibility criteria.
    </p>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form action="@(isEdit ? "/JobDrives/Edit" : "/JobDrives/Create")" method="post">
            @Html.AntiForgeryToken()

            <input asp-for="CompanyId" type="hidden" />
            <input asp-for="JobDriveId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>

            <h4 class="mb-3">Job information</h4>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="JobTitle" class="form-label"></label>
                    <input asp-for="JobTitle" class="form-control" />
                    <span asp-validation-for="JobTitle"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="JobDescription"
                           class="form-label"></label>
                    <textarea asp-for="JobDescription"
                              class="form-control"
                              rows="5"></textarea>
                    <span asp-validation-for="JobDescription"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SalaryPackage"
                           class="form-label"></label>
                    <input asp-for="SalaryPackage"
                           class="form-control"
                           type="number"
                           min="0"
                           step="0.01" />
                    <span asp-validation-for="SalaryPackage"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ApplicationDeadline"
                           class="form-label"></label>
                    <input asp-for="ApplicationDeadline"
                           class="form-control"
                           type="datetime-local"
                           value="@Model.ApplicationDeadline.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="ApplicationDeadline"
                          class="text-danger"></span>
                </div>
            </div>

            <hr class="my-4" />

            <h4 class="mb-3">Eligibility criteria</h4>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MinCGPA" class="form-label"></label>
                    <input asp-for="MinCGPA"
                           class="form-control"
                           type="number"
                           min="0"
                           max="10"
                           step="0.01" />
                    <span asp-validation-for="MinCGPA"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MaxBacklogs" class="form-label"></label>
                    <input asp-for="MaxBacklogs"
                           class="form-control"
                           type="number"
                           min="0" />
                    <span asp-validation-for="MaxBacklogs"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="GraduationYear"
                           class="form-label"></label>
                    <input asp-for="GraduationYear"
                           class="form-control"
                           type="number"
                           min="2000"
                           max="2100" />
                    <span asp-validation-for="GraduationYear"
                          class="text-danger"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="row g-4">
                <div class="col-lg-6">
                    <h4>Required skills</h4>
                    <p class="text-muted small">
                        Select existing Skills from the master list.
                    </p>

                    <span asp-validation-for="RequiredSkillIds"
                          class="text-danger d-block mb-2"></span>

                    @if (Model.AvailableSkills.Count == 0)
                    {
                        <div class="alert alert-warning">
                            No master Skills are available.
                        </div>
                    }
                    else
                    {
                        <div class="border rounded p-3">
                            @foreach (var skill in Model.AvailableSkills)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="RequiredSkillIds"
                                           value="@skill.SkillId"
                                           id="skill-@skill.SkillId"
                                           checked="@(Model.RequiredSkillIds.Contains(skill.SkillId)
                                               ? "checked"
                                               : null)" />

                                    <label class="form-check-label"
                                           for="skill-@skill.SkillId">
                                        @skill.SkillName
                                    </label>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="col-lg-6">
                    <h4>Eligible branches</h4>
                    <p class="text-muted small">
                        Select the student branches eligible for this job.
                    </p>

                    <span asp-validation-for="EligibleBranches"
                          class="text-danger d-block mb-2"></span>

                    <div class="border rounded p-3">
                        @foreach (var branch in Model.AvailableBranches)
                        {
                            var branchId =
                                $"branch-{branch.ToLowerInvariant()}";

                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="EligibleBranches"
                                       value="@branch"
                                       id="@branchId"
                                       checked="@(Model.EligibleBranches.Contains(branch)
                                           ? "checked"
                                           : null)" />

                                <label class="form-check-label"
                                       for="@branchId">
                                    @branch
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    @(isEdit ? "Save Changes" : "Create Job Drive")
                </button>

                <a asp-action="Index"
                   asp-route-companyId="@Model.CompanyId"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
