@model IReadOnlyList<AIPlacement.Application.Recruitment.DTOs.ApplicantDto>
@{ var job=(AIPlacement.Application.Jobs.DTOs.JobDriveDto)ViewBag.Job; var rounds=(IReadOnlyList<AIPlacement.Application.Recruitment.DTOs.InterviewRoundDto>)ViewBag.Rounds; var schedules=(IReadOnlyList<AIPlacement.Application.Recruitment.DTOs.InterviewScheduleDto>)ViewBag.Schedules; ViewData["Title"]="Applicants"; }
@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>} @if(TempData["Error"] is string er){<div class="alert alert-danger">@er</div>}
<div class="page-heading"><div><h1>@job.JobTitle Applicants</h1><p>Review candidates and move them through the hiring pipeline.</p></div></div>
<div class="card mb-4"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Candidate</th><th>Branch</th><th>Match</th><th>Status</th><th>Update</th></tr></thead><tbody>
@foreach(var item in Model){<tr><td><strong>@item.StudentName</strong><div class="text-muted">@item.RollNo · <a asp-action="ApplicantResume" asp-route-applicationId="@item.ApplicationId">Resume</a></div></td><td>@item.Branch</td><td>@(item.MatchScore?.ToString("0.0") ?? "—")</td><td><span class="badge text-bg-primary">@item.CurrentStatus</span></td><td><form asp-action="UpdateStatus" method="post" class="d-flex gap-2"><input type="hidden" name="applicationId" value="@item.ApplicationId"/><input type="hidden" name="jobDriveId" value="@job.JobDriveId"/><select name="status" class="form-select form-select-sm"><option>Applied</option><option>Under Review</option><option>Shortlisted</option><option>Assessment</option><option>Technical Interview</option><option>HR Interview</option><option>Selected</option><option>Rejected</option></select><input name="remarks" class="form-control form-control-sm" placeholder="Remarks"/><button class="btn btn-primary btn-sm">Save</button></form></td></tr>}
</tbody></table></div></div>
<div class="card"><div class="card-body"><h4>Add interview round</h4><form asp-action="AddRound" method="post" class="row g-2"><input type="hidden" name="JobDriveId" value="@job.JobDriveId"/><div class="col-md-4"><input name="RoundName" class="form-control" placeholder="Round name" required/></div><div class="col-md-3"><input name="RoundType" class="form-control" placeholder="Type"/></div><div class="col-md-2"><input name="SequenceNo" type="number" min="1" class="form-control" value="1"/></div><div class="col-md-3"><button class="btn btn-outline-primary">Create round</button></div></form></div></div>
@if(rounds.Any() && Model.Any()){<div class="card mt-4"><div class="card-body"><h4>Schedule interview</h4><form asp-action="Schedule" method="post" class="row g-2"><input type="hidden" name="jobDriveId" value="@job.JobDriveId"/><div class="col-md-3"><select name="ApplicationId" class="form-select">@foreach(var a in Model){<option value="@a.ApplicationId">@a.StudentName (@a.RollNo)</option>}</select></div><div class="col-md-2"><select name="RoundId" class="form-select">@foreach(var r in rounds){<option value="@r.RoundId">@r.SequenceNo. @r.RoundName</option>}</select></div><div class="col-md-3"><input name="ScheduledAt" type="datetime-local" class="form-control" required/></div><div class="col-md-2"><input name="Location" class="form-control" placeholder="Location"/></div><div class="col-md-2"><button class="btn btn-primary">Schedule</button></div></form></div></div>}
@if(schedules.Any()){<div class="card mt-4"><div class="card-body"><h4>Interview results</h4><div class="table-responsive"><table class="table"><thead><tr><th>Interview</th><th>Application</th><th>Time</th><th>Status</th><th>Record result</th></tr></thead><tbody>@foreach(var s in schedules){<tr><td>#@s.InterviewId / Round @s.RoundId</td><td>#@s.ApplicationId</td><td>@s.ScheduledAt.ToString("dd MMM yyyy HH:mm")</td><td>@s.Status</td><td>@if(s.Status!="Completed"){<form asp-action="RecordResult" method="post" class="d-flex gap-2"><input type="hidden" name="jobDriveId" value="@job.JobDriveId"/><input type="hidden" name="interviewId" value="@s.InterviewId"/><select name="Result" class="form-select form-select-sm"><option>Passed</option><option>Failed</option><option>On Hold</option></select><input name="Score" type="number" min="0" max="100" class="form-control form-control-sm" placeholder="Score" required/><input name="Remarks" class="form-control form-control-sm" placeholder="Remarks"/><button class="btn btn-sm btn-primary">Save</button></form>}</td></tr>}</tbody></table></div></div></div>}
