@model IReadOnlyList<AIPlacement.Application.Jobs.DTOs.JobDriveDto>
@{ ViewData["Title"]="Applicants"; }
<div class="page-heading"><div><h1>Recruitment Pipeline</h1><p>Select a job drive to review its applicants and interviews.</p></div></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Job drive</th><th>Status</th><th>Approval</th><th>Deadline</th><th></th></tr></thead><tbody>@foreach(var job in Model){<tr><td><strong>@job.JobTitle</strong><div class="text-muted">@job.Location</div></td><td>@job.Status</td><td>@job.ApprovalStatus</td><td>@job.ApplicationDeadline.ToString("dd MMM yyyy")</td><td><a asp-action="Applicants" asp-route-jobDriveId="@job.JobDriveId" class="btn btn-outline-primary btn-sm">Manage applicants</a></td></tr>}</tbody></table></div></div>
