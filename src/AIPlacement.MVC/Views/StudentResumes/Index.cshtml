@model IEnumerable<AIPlacement.Application.Resumes.DTOs.ResumeDto>
@{ViewData["Title"]="Resume";}<div class="page-heading"><div><h1>Resume</h1><p>Upload versioned PDF resumes and run AI analysis.</p></div></div>@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string er){<div class="alert alert-danger">@er</div>}<div class="card mb-4"><div class="card-body"><form asp-action="Upload" method="post" enctype="multipart/form-data" class="d-flex gap-2"><input name="file" type="file" accept="application/pdf,.pdf" class="form-control" required/><button class="btn btn-primary">Upload PDF</button></form><small class="text-muted">Maximum 5 MB. Uploading creates a new version and retains history.</small></div></div><div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>File</th><th>Version</th><th>Uploaded</th><th>Current</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.FileName</td><td>v@r.VersionNo</td><td>@r.UploadedAt?.ToString("dd MMM yyyy HH:mm")</td><td>@if(r.IsCurrent==true){<span class="badge text-bg-success">Current</span>}</td><td><div class="d-flex gap-2"><a asp-action="Download" asp-route-id="@r.ResumeId" class="btn btn-sm btn-outline-primary">Download</a><form asp-action="Analyze" asp-route-id="@r.ResumeId" method="post"><button class="btn btn-sm btn-primary">Analyze</button></form></div></td></tr>}</tbody></table></div></div>
