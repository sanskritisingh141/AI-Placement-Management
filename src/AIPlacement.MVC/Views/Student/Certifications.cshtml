@using AIPlacement.Application.Certifications.DTOs

@model IEnumerable<CertificationDto>

@{
    ViewData["Title"] = "My Certifications";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>My Certifications</h1>
            <p class="text-muted">
                Manage your professional and academic certifications.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addCertificationModal">
            Add Certification
        </button>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">

            @foreach (var certification in Model)
            {
                <div class="col-md-6 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h4 class="card-title mb-3">
                                @certification.CertificateName
                            </h4>

                            <p class="mb-2">
                                <strong>Issuing Organization:</strong>
                                @certification.IssuingOrganization
                            </p>

                            @if (certification.IssueDate.HasValue)
                            {
                                <p class="mb-2">
                                    <strong>Issue Date:</strong>
                                    @certification.IssueDate.Value.ToString("dd MMM yyyy")
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(certification.CredentialUrl))
                            {
                                <p class="mb-3">
                                    <strong>Credential:</strong>
                                    <a href="@certification.CredentialUrl"
                                       target="_blank"
                                       class="text-decoration-none">
                                        View Credential
                                    </a>
                                </p>
                            }

                            <div class="mt-3">

                                <button type="button"
                                        class="btn btn-warning me-2"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editCertificationModal">
                                    Edit
                                </button>

                                <button type="button"
                                        class="btn btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteCertificationModal">
                                    Delete
                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">

            <h5 class="mb-2">
                No certifications added yet.
            </h5>

            <p class="mb-0">
                Add your first certification using the
                <strong>Add Certification</strong> button above.
            </p>

        </div>
    }

</div>

<div class="modal fade"
     id="addCertificationModal"
     tabindex="-1"
     aria-labelledby="addCertificationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="addCertificationModalLabel">
                    Add Certification
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form method="post"
                  asp-controller="Student"
                  asp-action="AddCertification">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="StudentId"
                       value="@ViewBag.StudentId" />

                <div class="modal-body">

                    <div class="mb-3">

                        <label for="CertificateName"
                               class="form-label">
                            Certificate Name
                        </label>

                        <input type="text"
                               id="CertificateName"
                               name="CertificateName"
                               class="form-control"
                               placeholder="e.g. AWS Cloud Practitioner"
                               required />

                    </div>

                    <div class="mb-3">

                        <label for="IssuingOrganization"
                               class="form-label">
                            Issuing Organization
                        </label>

                        <input type="text"
                               id="IssuingOrganization"
                               name="IssuingOrganization"
                               class="form-control"
                               placeholder="e.g. Amazon Web Services"
                               required />

                    </div>

                    <div class="mb-3">

                        <label for="IssueDate"
                               class="form-label">
                            Issue Date
                        </label>

                        <input type="date"
                               id="IssueDate"
                               name="IssueDate"
                               class="form-control" />

                    </div>

                    <div class="mb-3">

                        <label for="CredentialUrl"
                               class="form-label">
                            Credential URL
                        </label>

                        <input type="url"
                               id="CredentialUrl"
                               name="CredentialUrl"
                               class="form-control"
                               placeholder="https://..." />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Add Certification
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<div class="modal fade"
     id="editCertificationModal"
     tabindex="-1"
     aria-labelledby="editCertificationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="editCertificationModalLabel">
                    Edit Certification
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <div class="mb-3">

                    <label class="form-label">
                        Certificate Name
                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="Certificate name" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Issuing Organization
                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="Issuing organization" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Issue Date
                    </label>

                    <input type="date"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Credential URL
                    </label>

                    <input type="url"
                           class="form-control"
                           placeholder="https://..." />

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary">
                    Save Changes
                </button>

            </div>

        </div>

    </div>

</div>

<div class="modal fade"
     id="deleteCertificationModal"
     tabindex="-1"
     aria-labelledby="deleteCertificationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="deleteCertificationModalLabel">
                    Delete Certification
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <p class="mb-0">
                    Are you sure you want to delete this certification?
                </p>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-danger">
                    Delete
                </button>

            </div>

        </div>

    </div>

</div>