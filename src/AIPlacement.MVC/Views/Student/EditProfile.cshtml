@model AIPlacement.Application.Students.DTOs.StudentDto

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Edit Profile</h1>
            <p class="text-muted">Update your student information.</p>
        </div>

        <a asp-controller="Student"
           asp-action="Profile"
           asp-route-studentId="@Model.StudentId"
           class="btn btn-outline-secondary">
            Cancel
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="EditProfile" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="StudentId" />

                <input type="hidden"
                       asp-for="UserId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="RollNo"
                               class="form-label">
                            Roll Number
                        </label>

                        <input asp-for="RollNo"
                               class="form-control" />

                        <span asp-validation-for="RollNo"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Branch"
                               class="form-label">
                            Branch
                        </label>

                        <input asp-for="Branch"
                               class="form-control" />

                        <span asp-validation-for="Branch"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="CGPA"
                               class="form-label">
                            CGPA
                        </label>

                        <input asp-for="CGPA"
                               class="form-control"
                               type="number"
                               step="0.01" />

                        <span asp-validation-for="CGPA"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="GraduationYear"
                               class="form-label">
                            Graduation Year
                        </label>

                        <input asp-for="GraduationYear"
                               class="form-control"
                               type="number" />

                        <span asp-validation-for="GraduationYear"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone"
                               class="form-label">
                            Phone
                        </label>

                        <input asp-for="Phone"
                               class="form-control"
                               type="tel" />

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DateOfBirth"
                               class="form-label">
                            Date of Birth
                        </label>

                        <input asp-for="DateOfBirth"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="DateOfBirth"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <div class="mt-3">
                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="Student"
                       asp-action="Profile"
                       asp-route-studentId="@Model.StudentId"
                       class="btn btn-secondary ms-2">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}