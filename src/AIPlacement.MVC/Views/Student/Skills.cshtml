@model IEnumerable<AIPlacement.Application.Skills.DTOs.SkillDto>

@{
    ViewData["Title"] = "My Skills";
    var studentId = ViewBag.StudentId;
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>My Skills</h1>
            <p class="text-muted">
                Manage your technical and professional skills.
            </p>
        </div>

        <a asp-controller="Student"
           asp-action="Dashboard"
           asp-route-studentId="@studentId"
           class="btn btn-outline-primary">
            Back to Dashboard
        </a>
    </div>


    <!-- Add Skill -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 class="mb-3">Add Skill</h4>

            <form asp-controller="Student"
                  asp-action="AddSkill"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="StudentId"
                       value="@studentId" />

                <div class="row">

                    <div class="col-md-5 mb-3">
                        <label class="form-label">
                            Skill Name
                        </label>

                        <input type="text"
                               name="SkillName"
                               class="form-control"
                               placeholder="e.g. Python"
                               required />
                    </div>

                    <div class="col-md-5 mb-3">
                        <label class="form-label">
                            Proficiency Level
                        </label>

                        <select name="ProficiencyLevel"
                                class="form-select"
                                required>

                            <option value="">
                                Select proficiency
                            </option>

                            <option value="Beginner">
                                Beginner
                            </option>

                            <option value="Intermediate">
                                Intermediate
                            </option>

                            <option value="Advanced">
                                Advanced
                            </option>

                            <option value="Expert">
                                Expert
                            </option>

                        </select>
                    </div>

                    <div class="col-md-2 mb-3 d-flex align-items-end">
                        <button type="submit"
                                class="btn btn-primary w-100">
                            Add Skill
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>


    <!-- Existing Skills -->
    <div class="card shadow-sm">
        <div class="card-body">

            <h4 class="mb-3">Your Skills</h4>

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Skill</th>
                                <th>Proficiency</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var skill in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @skill.SkillName
                                        </strong>
                                    </td>

                                    <td>
                                        @skill.ProficiencyLevel
                                    </td>

                                    <td class="text-end">

                                        <!-- Edit -->
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editSkillModal-@skill.SkillId">
                                            Edit
                                        </button>

                                        <!-- Delete -->
                                        <form asp-controller="Student"
                                              asp-action="DeleteSkill"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="skillId"
                                                   value="@skill.SkillId" />

                                            <input type="hidden"
                                                   name="studentId"
                                                   value="@skill.StudentId" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Are you sure you want to delete this skill?');">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-4">

                    <p class="text-muted mb-3">
                        You haven't added any skills yet.
                    </p>

                    <p class="text-muted">
                        Add your first skill using the form above.
                    </p>

                </div>
            }

        </div>
    </div>


    <!-- Edit Skill Modals -->
    @if (Model != null)
    {
        foreach (var skill in Model)
        {
            <div class="modal fade"
                 id="editSkillModal-@skill.SkillId"
                 tabindex="-1"
                 aria-hidden="true">

                <div class="modal-dialog">

                    <div class="modal-content">

                        <div class="modal-header">

                            <h5 class="modal-title">
                                Edit Skill
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                            </button>

                        </div>

                        <form asp-controller="Student"
                              asp-action="EditSkill"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div class="modal-body">

                                <input type="hidden"
                                       name="SkillId"
                                       value="@skill.SkillId" />

                                <input type="hidden"
                                       name="StudentId"
                                       value="@skill.StudentId" />

                                <div class="mb-3">

                                    <label class="form-label">
                                        Skill Name
                                    </label>

                                    <input type="text"
                                           name="SkillName"
                                           value="@skill.SkillName"
                                           class="form-control"
                                           required />

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">
                                        Proficiency Level
                                    </label>

                                    <select name="ProficiencyLevel"
                                            class="form-select"
                                            required>

                                        @if (skill.ProficiencyLevel == "Beginner")
                                        {
                                            <option value="Beginner" selected>
                                                Beginner
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="Beginner">
                                                Beginner
                                            </option>
                                        }

                                        @if (skill.ProficiencyLevel == "Intermediate")
                                        {
                                            <option value="Intermediate" selected>
                                                Intermediate
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="Intermediate">
                                                Intermediate
                                            </option>
                                        }

                                        @if (skill.ProficiencyLevel == "Advanced")
                                        {
                                            <option value="Advanced" selected>
                                                Advanced
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="Advanced">
                                                Advanced
                                            </option>
                                        }

                                        @if (skill.ProficiencyLevel == "Expert")
                                        {
                                            <option value="Expert" selected>
                                                Expert
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="Expert">
                                                Expert
                                            </option>
                                        }

                                    </select>

                                </div>

                            </div>

                            <div class="modal-footer">

                                <button type="button"
                                        class="btn btn-secondary"
                                        data-bs-dismiss="modal">
                                    Cancel
                                </button>

                                <button type="submit"
                                        class="btn btn-primary">
                                    Save Changes
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>
        }
    }

</div>